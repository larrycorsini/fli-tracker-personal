# Fli-Tracker local secrets (copy to .env and fill in — never commit .env)
#
# seats.aero Pro Partner API — cached search for premium award deals (find_deals.py).
# Get your key from seats.aero account settings. 1000 calls/day, resets UTC midnight.
SEATS_AERO_API_KEY=your_pro_key_here

# Optional: iMessage alerts (also set in launchd plist for scheduled runs)
# FLI_ALERT_PHONE=+1XXXXXXXXXX
